{
  "name": "react-vite",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm generate-i18n && tsc -b && vite build",
    "preview": "vite preview",
    "generate-i18n": "tsx scripts/merge-i18n.ts && paraglide-js compile --project ./project.inlang --outdir ./src/integrations/i18n/paraglide --strategy localStorage baseLocale"
  },
  "dependencies": {
    "@config/i18n": "workspace:^",
    "@contracts/auth": "workspace:^",
    "@react/design-system": "workspace:^",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-form-devtools": "0.2.34",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-query-devtools": "5.104.1",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-router-devtools": "1.167.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.27.0",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/router-plugin": "1.168.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2"
  }
}
