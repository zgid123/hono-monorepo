{
  "name": "hono-monorepo",
  "version": "0.0.1",
  "description": "Monorepo for Hono framework",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "update-packages": "pnpm update -i -r --latest",
    "storybook": "storybook dev -p 6006",
    "clear": "pnpm -r exec rimraf node_modules dist .turbo lib && pnpm rimraf node_modules .turbo",
    "build": "turbo run build",
    "test": "vitest run --coverage",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "hono",
    "monorepo",
    "react",
    "vite",
    "next",
    "start",
    "tanstack"
  ],
  "author": "Alpha",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.2",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@alphacifer/biome": "^0.0.11",
    "@alphacifer/tsconfig": "^0.0.16",
    "@biomejs/biome": "2.5.15",
    "@chromatic-com/storybook": "5.4.0",
    "@faker-js/faker": "10.6.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@vitest/coverage-istanbul": "5.0.3",
    "dotenv-cli": "11.0.0",
    "fishery": "2.4.0",
    "lefthook": "2.1.17",
    "rimraf": "6.1.3",
    "storybook": "10.6.1",
    "tsc-alias": "1.9.7",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@alphacifer/axios": "^0.0.3",
    "@alphacifer/core-utils": "^0.0.10",
    "@arkenv/core": "1.0.0-rc.4",
    "arktype": "2.2.7",
    "better-auth": "1.7.7",
    "dotenv": "18.0.5",
    "string-interpolation-js": "^1.0.9",
    "tslib": "2.8.1"
  }
}
