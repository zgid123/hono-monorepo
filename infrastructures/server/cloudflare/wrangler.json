{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hono-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "ServerContainer",
      "max_instances": 1,
      "image": "registry.cloudflare.com/ACCOUNT_ID/hono-server:replace-at-release"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SERVER_CONTAINER",
        "class_name": "ServerContainer"
      }
    ]
  },
  "exports": {
    "ServerContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
